
{% extends "layout.twig" %}

{% block content %}
<div class="followup-page" dir="rtl">
    <header class="page-header">
        <div>
            <p class="eyebrow">پنل مدیریت CRM</p>
              <div class="user-switcher" dir="rtl">
    <label for="currentUser">ورود:</label>

    <select id="currentUser">
        <option value="1">ادمین</option>
        <option value="2">کاربر ۲</option>
        <option value="3">کاربر ۳</option>
    </select>
</div>
            <h1>مدیریت پیگیری مشتریان</h1>
            <p class="subtitle">ثبت، مشاهده و مدیریت پیگیری‌های مشتریان</p>
        </div>
    </header>

    <section class="stats">
        <div class="stat-card">
            <span>کل پیگیری‌ها</span>
            <strong id="totalCount">۰</strong>
        </div>
        <div class="stat-card">
            <span>پیگیری‌های باز</span>
            <strong id="openCount">۰</strong>
        </div>
        <div class="stat-card">
            <span>تکمیل‌شده</span>
            <strong id="completedCount">۰</strong>
        </div>
    </section>

    <section class="panel">
        <h2>ثبت پیگیری جدید</h2>

        <form id="followupForm">
            <div class="form-grid">
                <label>
                    شناسه مشتری
                    <input type="number" name="customer_id"
                           min="1" required placeholder="مثلاً ۱">
                </label>

                <label>
                    عنوان پیگیری
                    <input type="text" name="title"
                           maxlength="200" required
                           placeholder="عنوان پیگیری را وارد کنید">
                </label>

                <label>
                    اولویت
                    <select name="priority">
                        <option value="normal">عادی</option>
                        <option value="high">زیاد</option>
                        <option value="low">کم</option>
                    </select>
                </label>

                <label>
                    زمان پیگیری
                    <input
                     type="text"
                     id="dueAtPicker"
                     placeholder="انتخاب تاریخ و ساعت شمسی"
                     autocomplete="off"
                     readonly
                      required
                >

                <input type="hidden" name="due_at" id="due_at">


                </label>

                <label class="full-width">
                    توضیحات
                    <textarea name="description" rows="3"
                              placeholder="توضیحات پیگیری..."></textarea>
                </label>
            </div>

<div class="form-actions">
    <button type="submit" class="primary-button" id="submitButton">
        ثبت پیگیری
    </button>

    <button type="button" class="secondary-button"
            id="cancelEditButton" hidden>
        لغو ویرایش
    </button>
</div>

            <p id="formMessage" role="status"></p>
        </form>
    </section>

    <section class="panel">
<div class="list-header">
    <h2>فهرست پیگیری‌ها</h2>
    <div class="pagination-controls">
        <button type="button" id="prevPage" disabled>
            صفحه قبل
        </button>

        <span id="pageInfo">صفحه ۱</span>

        <button type="button" id="nextPage">
            صفحه بعد
        </button>
    </div>

<div id="filterModal" class="filter-modal" hidden>
    <div class="filter-modal-content" dir="rtl">
        <h3>فیلتر پیگیری‌ها</h3>
        <label for="filterTitle">عنوان پیگیری</label>
        <input
            type="text"
            id="filterTitle"
        >
        <label for="filterPriority">اولویت</label>
        <select id="filterPriority">
            <option value="">همه اولویت‌ها</option>
            <option value="low">کم</option>
            <option value="normal">عادی</option>
            <option value="high">زیاد</option>
        </select>

        <label for="filterStatus">وضعیت</label>
        <select id="filterStatus">
            <option value="">همه وضعیت‌ها</option>
            <option value="open">باز</option>
            <option value="completed">تکمیل‌شده</option>
        </select>

        <div class="filter-modal-actions">
            <button type="button" id="applyFilters">اعمال فیلتر</button>
            <button type="button" id="clearFilters">پاک کردن فیلترها</button>
            <button type="button" id="closeFilterButton">بستن</button>
        </div>
    </div>
</div>


    <button type="button" id="refreshButton" class="secondary-button">
        بروزرسانی فهرست
    </button>
    <button type="button" id="openFilterButton" class="secondary-button">
    فیلتر
</button>
</div>
        <div id="listMessage" role="status">در حال آماده‌سازی فهرست...</div>
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>شناسه</th>
                        <th>مشتری</th>
                        <th>عنوان</th>
                        <th>اولویت</th>
                        <th>وضعیت</th>
                        <th>موعد پیگیری</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody id="followupRows">
                    <tr>
                        <td colspan="7">فهرست در حال بارگذاری است.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}
